default_platform(:ios)

platform :ios do
  desc "Setup signing assets with Apple Developer Portal"
  lane :prepare_signing do
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
    api_key = app_store_connect_api_key(
      key_id: ENV['APPSTORE_KEY_ID'],
      issuer_id: ENV['APPSTORE_ISSUER_ID'],
      key_filepath: key_path,
      in_house: false
    )

    get_certificates(
      api_key: api_key,
      type: "distribution",
      keychain_path: ENV['KEYCHAIN_PATH'],
      keychain_password: ENV['KEYCHAIN_PASSWORD']
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.kaunos.kirmatas",
      adhoc: false,
      output_path: "#{Dir.home}/Library/MobileDevice/Provisioning Profiles",
      filename: "Kirmatas_AppStore.mobileprovision"
    )
  end
end
