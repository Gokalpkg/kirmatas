default_platform(:ios)

platform :ios do
  before_all do
    all_xcodes = Dir["/Applications/Xcode*.app"].sort
    puts "Available Xcode installations: #{all_xcodes.inspect}"
    selected_xcode = all_xcodes.reverse.find { |p| p.include?("26") } || all_xcodes.reverse.find { |p| !p.include?("16.2") } || all_xcodes.last
    if selected_xcode && File.directory?(selected_xcode)
      puts "Selected Xcode for iOS build: #{selected_xcode}"
      ENV["DEVELOPER_DIR"] = "#{selected_xcode}/Contents/Developer"
      if ENV["GITHUB_ENV"] && File.exist?(ENV["GITHUB_ENV"])
        File.open(ENV["GITHUB_ENV"], "a") { |f| f.puts("DEVELOPER_DIR=#{selected_xcode}/Contents/Developer") }
      end
    end
  end

  desc "Setup signing assets with Apple Developer Portal"
  lane :prepare_signing do
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
    key_content = File.read(key_path)
    api_key = app_store_connect_api_key(
      key_id: ENV['APPSTORE_KEY_ID'],
      issuer_id: ENV['APPSTORE_ISSUER_ID'],
      key_content: key_content,
      in_house: false
    )

    keychain_p = ENV['KEYCHAIN_PATH'] || "#{Dir.home}/Library/Keychains/login.keychain-db"
    keychain_pw = ENV['KEYCHAIN_PASSWORD'] || ""

    get_certificates(
      api_key: api_key,
      force: false,
      keychain_path: keychain_p,
      keychain_password: keychain_pw
    )

    profile_path = get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.kaunos.kirmatas",
      provisioning_name: "com.kaunos.kirmatas AppStore",
      adhoc: false,
      output_path: "#{Dir.home}/Library/MobileDevice/Provisioning Profiles",
      filename: "Kirmatas_AppStore.mobileprovision",
      force: true
    )

    actual_profile_name = lane_context[SharedValues::SIGH_NAME]
    actual_profile_uuid = lane_context[SharedValues::SIGH_UDID]
    puts "SIGH created profile: #{actual_profile_name} (UUID: #{actual_profile_uuid})"

    # Ensure Xcode finds the profile by both filename and UUID
    if actual_profile_uuid && File.exist?(profile_path)
      uuid_profile_dest = "#{Dir.home}/Library/MobileDevice/Provisioning Profiles/#{actual_profile_uuid}.mobileprovision"
      FileUtils.cp(profile_path, uuid_profile_dest)
      puts "Installed profile to #{uuid_profile_dest}"
    end

    # Sync Release.xcconfig with the exact profile name generated by sigh
    xcconfig_path = File.expand_path("../Flutter/Release.xcconfig", __dir__)
    if File.exist?(xcconfig_path) && actual_profile_name
      content = File.read(xcconfig_path)
      content.gsub!(/PROVISIONING_PROFILE_SPECIFIER\s*=\s*.*/, "PROVISIONING_PROFILE_SPECIFIER = #{actual_profile_name}")
      File.write(xcconfig_path, content)
      puts "Synced Release.xcconfig with PROVISIONING_PROFILE_SPECIFIER = #{actual_profile_name}"
    end

    # Sync ExportOptions.plist with the exact profile name generated by sigh
    export_plist_path = File.expand_path("../ExportOptions.plist", __dir__)
    if File.exist?(export_plist_path) && actual_profile_name
      content = File.read(export_plist_path)
      content.gsub!(/<key>com\.kaunos\.kirmatas<\/key>\s*<string>.*?<\/string>/m, "<key>com.kaunos.kirmatas</key>\n        <string>#{actual_profile_name}</string>")
      File.write(export_plist_path, content)
      puts "Synced ExportOptions.plist with profile name = #{actual_profile_name}"
    end
  end

  desc "Upload to TestFlight via App Store Connect API"
  lane :upload_testflight do
    key_path = File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{ENV['APPSTORE_KEY_ID']}.p8")
    key_content = File.read(key_path)
    api_key = app_store_connect_api_key(
      key_id: ENV['APPSTORE_KEY_ID'],
      issuer_id: ENV['APPSTORE_ISSUER_ID'],
      key_content: key_content,
      in_house: false
    )

    ipa_path = Dir["../build/ios/ipa/*.ipa"].first || "../build/ios/ipa/kirmatas.ipa"

    upload_to_testflight(
      api_key: api_key,
      app_identifier: "com.kaunos.kirmatas",
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
